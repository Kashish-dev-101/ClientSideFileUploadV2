# ImageKit Configuration
# Get these values from your ImageKit dashboard: https://imagekit.io/dashboard/developer/api-keys

IMAGEKIT_PUBLIC_KEY=your_public_key_here
IMAGEKIT_PRIVATE_KEY=your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# CORS Configuration
# Note port 5501, not 5500 — avoids clashing with the V1 ClientSideFileUpload demo's frontend server
ALLOWED_ORIGIN=http://localhost:5501,http://127.0.0.1:5501
